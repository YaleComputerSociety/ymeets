{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "plugins": ["jest"],
      "env": {
        "jest": true
      }
    }
  ]
}
